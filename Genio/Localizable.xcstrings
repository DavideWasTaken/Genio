    "Add your Gemini API key in Settings, then press the button on your glasses.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la chiave API di Gemini nelle impostazioni, poi premi il pulsante sugli occhiali."
