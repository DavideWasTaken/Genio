      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega a Meta AI"
          }
        }
      }
    },
    "Link with Meta AI first": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da collegare a Meta AI"
          }
        }
      }
    },
