    "Glasses": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occhiali"
          }
        }
      }
    },
    "Glasses not connected: unfold and wear them, and check that Meta AI shows them connected and Bluetooth is on.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occhiali non collegati: aprili, indossali e controlla che Meta AI li veda connessi e che il Bluetooth sia acceso."
          }
        }
      }
    },
    "Heard": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho sentito"
          }
        }
      }
    },
    "Invalid identity token.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token di identità non valido."
          }
        }
      }
    },
    "Invalid sign-in response (state).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta di accesso non valida (state)."
          }
        }
      }
    },
    "Key from console.anthropic.com; it stays in this iPhone's keychain. The coach uses Claude Haiku 5.5.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave da console.anthropic.com: resta nel portachiavi di questo iPhone. Il coach usa Claude Haiku 5.5."
          }
        }
      }
    },
