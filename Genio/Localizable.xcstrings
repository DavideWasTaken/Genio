      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voce"
          }
        }
      }
    },
    "Voice language": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingua della voce"
          }
        }
      }
    },
    "Waiting for the glasses": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa degli occhiali"
          }
        }
      }
    },
    "Your Gemini API key from aistudio.google.com, kept in this iPhone's keychain. Changes apply the next time GENIO starts.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave API di Gemini da aistudio.google.com, conservata nel portachiavi di questo iPhone. Le modifiche valgono dal prossimo avvio di GENIO."
          }
        }
      }
    },
