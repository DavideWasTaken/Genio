    },
    "Session not started: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessione non avviata: %@"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni"
          }
        }
      }
    },
    "Short press": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione breve"
          }
        }
      }
    },
    "Speak: the bar should move. You should hear a chime on the glasses. This uses the same two-way Bluetooth audio as Gemini Live.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla: la barra deve muoversi. Dovresti sentire un suono negli occhiali. Usa lo stesso audio Bluetooth bidirezionale di Gemini Live."
          }
        }
      }
    },
    "Speaker": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altoparlante"
          }
        }
      }
    },
    "Start GENIO": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia GENIO"
          }
        }
      }
    },
    "Start the audio test": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la prova audio"
          }
        }
      }
    },
    "Step %lld of %lld": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo %lld di %lld"
          }
        }
      }
    },
    "Step %lld of %lld · paused, press to resume": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo %lld di %lld · in pausa, premi per riprendere"
          }
        }
      }
    },
    "Stop the audio test": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma la prova audio"
          }
        }
      }
    },
    "Take a frame": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta un fotogramma"
          }
        }
      }
    },
    "Test audio and camera": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova audio e fotocamera"
          }
        }
      }
    },
    "The Gemini API key is missing (Settings).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca la chiave API di Gemini (Impostazioni)."
          }
        }
      }
    },
    "The camera turns on only when Genio needs to see, or while this page is open, to save the glasses' battery.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera si accende solo quando Genio deve vedere, o con questa pagina aperta, per risparmiare la batteria degli occhiali."
          }
        }
      }
    },
    "The glasses camera is not available.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera degli occhiali non è disponibile."
          }
        }
      }
    },
    "The glasses need an update: Meta AI → your glasses → updates.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli occhiali vanno aggiornati: Meta AI → i tuoi occhiali → aggiornamenti."
          }
        }
      }
    },
    "The glasses software needs an update.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va aggiornato il software degli occhiali."
          }
        }
      }
    },
    "The glasses' button only starts GENIO: while it runs, the glasses keep the button for photos. To switch off, say \"Genio stop\". If a short press also takes a photo when GENIO is off, pick double or long press.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto degli occhiali serve solo ad accendere GENIO: mentre è attivo, gli occhiali usano il tasto per le foto. Per spegnere di' \"Genio stop\". Se la pressione breve scatta una foto anche con GENIO spento, scegli doppia o lunga."
          }
        }
      }
    },
    "The microphone could not start.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono non è partito."
          }
        }
      }
    },
    "The microphone is not the glasses: check that they are connected as Bluetooth audio in iOS Settings.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono non è quello degli occhiali: controlla che siano collegati come audio Bluetooth nelle Impostazioni di iOS."
          }
        }
      }
    },
    "Update the glasses software": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna il software degli occhiali"
          }
        }
      }
    },
