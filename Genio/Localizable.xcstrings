      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega prima gli occhiali."
          }
        }
      }
    },
    "Connect the glasses first: GENIO needs their camera, button and microphone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima connetti gli occhiali: a GENIO servono la loro camera, il tasto e il microfono."
