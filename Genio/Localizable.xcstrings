      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con ChatGPT nelle impostazioni."
          }
        }
      }
    },
    "Sign out of ChatGPT": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da ChatGPT"
          }
        }
      }
