      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occhiali"
          }
        }
      }
    },
    "Glasses not connected: unfold and wear them, and check that Meta AI shows them connected and Bluetooth is on.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occhiali non collegati: aprili, indossali e controlla che Meta AI li veda connessi e che il Bluetooth sia acceso."
          }
        }
      }
    },
