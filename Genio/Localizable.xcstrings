      }
    },
    "Genio": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genio"
          }
        }
      }
    },
    "Genio is listening. Say \"Genio stop\" to switch off.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genio ti ascolta. Di' \"Genio stop\" per spegnerlo."
          }
        }
      }
    },
