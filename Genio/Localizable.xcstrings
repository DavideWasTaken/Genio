            "value": "Non connessi"
          }
        }
      }
    },
    "Nothing yet: connect the glasses or start GENIO.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente: connetti gli occhiali o avvia GENIO."
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spento"
          }
        }
      }
    },
    "Press the button on your glasses or tap here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il pulsante sugli occhiali o tocca qui."
          }
        }
      }
    },
    "Reconnecting (%lld)…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnessione (%lld)…"
          }
        }
      }
    },
