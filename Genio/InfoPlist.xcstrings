    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genio si collega ai tuoi occhiali Meta via Bluetooth."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genio può raggiungere gli occhiali anche via Wi-Fi, che porta più video del Bluetooth."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genio ti ascolta dal microfono degli occhiali e parla con te tramite Gemini."
          }
        }
      }
    }
  },
  "version": "1.0"
}